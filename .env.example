# ==========================================
# TimeBack Calling — 环境变量配置
# 复制此文件为 .env 并填入真实 API Key
# ==========================================

PORT=3000

# 智谱 AI (必需) — LLM + ASR
ZHIPU_API_KEY=your_zhipu_key_here

# MiniMax (可选) — TTS 语音合成 + 声音克隆
MINIMAX_API_KEY=your_minimax_key_here

# Fish Audio (可选) — TTS 语音合成
FISH_AUDIO_API_KEY=your_fish_audio_key_here

# D-ID (可选) — 数字人视频（已被 LiveTalking 替代）
DID_API_KEY=your_did_key_here
